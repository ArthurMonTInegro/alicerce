# Copie para .env (nunca versione o .env). Todas são opcionais.
PORT=3001
# DATABASE_PATH=./apps/api/data/alicerce.db
# Tutor com IA: sem a chave, o tutor funciona no modo offline (dicas guiadas).
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-sonnet-5-5
# TUTOR_DAILY_LIMIT=60
# Atrás de proxy reverso com HTTPS:
# TRUST_PROXY=true
# COOKIE_SECURE=true
# Usado no sitemap, canonical e robots.txt durante o build:
# SITE_URL=https://seu-dominio
